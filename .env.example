# Clave de API para Google Gemini Flash (Obtén la tuya en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini (por defecto gemini-2.5-flash / gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Servidor de Ollama local (opcional si usas Llama 3)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
# Mantener Llama 3 cargado indefinidamente en memoria RAM (-1)
OLLAMA_KEEP_ALIVE=-1
