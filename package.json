{
  "name": "capri-desktop",
  "version": "0.3.1",
  "description": "Capri, the Project Capricorn construct, living on your desktop as an interactive aesthetic desktop pet (Only-View Edition).",
  "author": "mochiiwuff",
  "repository": "github:mochiiwuff/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron --ozone-platform-hint=auto --enable-features=WaylandWindowDecorations .",
    "start:wayland": "electron --ozone-platform=wayland --enable-features=WaylandWindowDecorations .",
    "start:x11": "electron --ozone-platform=x11 .",
    "dev": "electron --ozone-platform-hint=auto --enable-features=WaylandWindowDecorations . --dev",
    "dev:wayland": "electron --ozone-platform=wayland --enable-features=WaylandWindowDecorations . --dev",
    "dev:x11": "electron --ozone-platform=x11 . --dev",
    "dist": "electron-builder --linux",
    "dist:linux": "electron-builder --linux",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners",
    "linux",
    "cachyos",
    "niri"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "config/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Utility",
      "icon": "assets/icons/capri.png"
    }
  }
}
